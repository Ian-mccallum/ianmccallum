{
  "name": "ianinnovates",
  "version": "2.0.0",
  "description": "Ian McCallum's Astro-powered Aero portfolio and CV",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-sitemaps.mjs",
    "sitemap:dates": "node scripts/sitemap-dates.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "validate:assets": "node scripts/validate-assets.mjs",
    "test:api": "node --test tests/api-contract.test.cjs",
    "test:site": "node --test tests/site-contract.test.mjs tests/image-seo.test.mjs tests/favicon.test.mjs tests/sitemap.test.mjs tests/seo-metadata.test.mjs",
    "test:browser": "node tests/browser-qa.mjs",
    "test:performance": "node tests/performance-qa.mjs",
    "test": "npm run check && npm run build && npm run validate:assets && npm run test:api && npm run test:site"
  },
  "keywords": [
    "personal-website",
    "portfolio",
    "vista-ui",
    "frutiger-aero"
  ],
  "author": "Ian McCallum",
  "license": "MIT",
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2"
  }
}
