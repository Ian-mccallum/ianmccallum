{
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/pages/index.html"
    },
    {
      "source": "/about",
      "destination": "/src/pages/about.html"
    },
    {
      "source": "/cv",
      "destination": "/src/pages/cv.html"
    },
    {
      "source": "/photos",
      "destination": "/src/pages/photos.html"
    },
    {
      "source": "/portfolio",
      "destination": "/src/pages/portfolio.html"
    },
    {
      "source": "/testimonials",
      "destination": "/src/pages/testimonials.html"
    },
    {
      "source": "/contact",
      "destination": "/src/pages/contact.html"
    },
    {
      "source": "/thank-you",
      "destination": "/src/pages/thank-you.html"
    }
  ]
}
