---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishedAt?: Date;
  noindex?: boolean;
}

const { title, description, image = '/images/ian-mccallum-headshot.jpg', type = 'website', publishedAt, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="msvalidate.01" content="AFF3B15771E77519B6D2364A2F2F85A9" />
<meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />
<meta name="theme-color" content="#0067bc" />
<meta name="color-scheme" content="light" />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="Ian McCallum" href={new URL('/feed.xml', Astro.site)} />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<title>{title}</title>
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Ian McCallum" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={image === '/images/ian-mccallum-headshot.jpg' ? 'Portrait of Ian McCallum' : title} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
