---
import Titlebar from './Titlebar.astro';
import type { IconName } from '../../data/navigation';
interface Props { title: string; icon: IconName | 'warning' | 'project'; reading?: boolean }
const { title, icon, reading = false } = Astro.props;
---

<section class:list={['window-frame', 'is-maximized', { 'window-frame--reading': reading }]} data-window-frame aria-label={`${title} window`}>
  <Titlebar title={title} icon={icon} />
  <div class="window-frame__body"><slot /></div>
  <div class="window-statusbar"><span>{title}</span><span class="window-statusbar__grip" aria-hidden="true"></span></div>
</section>
