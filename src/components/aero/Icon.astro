---
import type { IconName } from '../../data/navigation';

interface Props { name: IconName | 'warning' | 'project'; size?: number; decorative?: boolean; loading?: 'eager' | 'lazy' }
const { name, size = 32, decorative = true, loading = 'eager' } = Astro.props;
const icons = {
  welcome: 'vista_get_started',
  about: 'vista_personalization',
  portfolio: 'vista_photo_gallery',
  cv: 'vista_book_3',
  photos: 'vista_photo_gallery',
  testimonials: 'vista_info',
  contact: 'thunderbird2',
  blog: 'vista_sticky_notes',
  warning: 'vista_warning',
  project: 'explorer',
} as const;
// One 256px master per icon, served at 64/128/256 so a 3× iPhone screen never upscales.
const base = `/icons/${icons[name]}`;
---

<img src={`${base}.png`} srcset={`${base}.png 64w, ${base}-128.webp 128w, ${base}-256.webp 256w`} sizes={`${size}px`} width={size} height={size} alt={decorative ? '' : name} aria-hidden={decorative ? 'true' : undefined} loading={loading} decoding="async" />
