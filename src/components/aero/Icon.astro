---
import type { IconName } from '../../data/navigation';

interface Props { name: IconName | 'warning' | 'project'; size?: number; decorative?: boolean }
const { name, size = 32, decorative = true } = Astro.props;
const icons = {
  welcome: '/icons/vista_get_started.png',
  about: '/icons/vista_personalization.png',
  portfolio: '/icons/vista_photo_gallery.png',
  cv: '/icons/vista_book_3.png',
  photos: '/icons/vista_photo_gallery.png',
  testimonials: '/icons/vista_info.png',
  contact: '/icons/thunderbird1.png',
  blog: '/icons/vista_sticky_notes.png',
  warning: '/icons/vista_warning.png',
  project: '/icons/explorer.png',
} as const;
---

<img src={icons[name]} width={size} height={size} alt={decorative ? '' : name} aria-hidden={decorative ? 'true' : undefined} loading="eager" decoding="async" />
