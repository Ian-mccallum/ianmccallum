---
import Icon from './Icon.astro';
import WindowControls from './WindowControls.astro';
import type { IconName } from '../../data/navigation';
interface Props { title: string; icon: IconName | 'warning' | 'project' }
const { title, icon } = Astro.props;
---

<header class="window-titlebar">
  <div class="window-titlebar__title"><Icon name={icon} size={18} /><span>{title}</span></div>
  <WindowControls />
</header>
