---
import Icon from './Icon.astro';
import StartMenu from './StartMenu.astro';
import SocialIcon from './SocialIcon.astro';
import { navigation } from '../../data/navigation';
import { socialLinks } from '../../data/social';
import type { IconName } from '../../data/navigation';
interface Props { path: string; title: string; icon: IconName | 'warning' | 'project' }
const { path, title, icon } = Astro.props;
const pinned = navigation.filter((item) => ['/', '/about', '/portfolio', '/blog', '/contact'].includes(item.href));
const currentIsPinned = pinned.some((item) => item.href === path);
---

<StartMenu />
<footer class="taskbar">
  <button class="start-button" type="button" aria-label="Start" aria-controls="start-menu" aria-expanded="false" data-start-button>
    <span class="start-im" aria-hidden="true"><img src="/images/im-start-green.svg" width="36" height="36" alt="" /></span><span class="start-label">Start</span>
  </button>
  <span class="taskbar-separator" aria-hidden="true"></span>
  <nav class="taskbar-pins" aria-label="Pinned pages">
    {pinned.map((item) => (
      <a
        class:list={['taskbar-item', { 'is-open is-active': item.href === path }]}
        href={item.href}
        data-window-link
        data-taskbar-route={item.href}
        aria-label={`Open ${item.label}`}
      >
        <Icon name={item.icon} size={22} /><span>{item.label === 'Welcome' ? 'Home' : item.label}</span>
      </a>
    ))}
  </nav>
  <div class="taskbar-running" data-taskbar-running>
    {!currentIsPinned && (
      <a class="taskbar-item is-open is-active" href={path} data-taskbar-route={path} aria-label={`Restore ${title}`}>
        <Icon name={icon} size={22} /><span>{title}</span>
      </a>
    )}
  </div>
  <div class="taskbar-spacer"></div>
  <nav class="taskbar-socials" aria-label="Social profiles">
    {socialLinks.map((link) => (
      <a href={link.href} target="_blank" rel="me noopener" aria-label={link.label} title={link.label}>
        <SocialIcon name={link.label} size={17} />
      </a>
    ))}
  </nav>
  <span class="taskbar-separator" aria-hidden="true"></span>
  <div class="taskbar-clock" aria-label="Current local time"><time data-clock></time><span data-date>Central</span></div>
</footer>

<style>
  .start-button { min-width: 44px; height: 44px; border-radius: 12px 4px 4px 12px; }
  .start-im { position: relative; display: block; flex: 0 0 36px; width: 36px; height: 36px; overflow: hidden; border-radius: 9px; }
  .start-im img { display: block; width: 36px; height: 36px; }
  .start-im::after { content: ''; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / .65) 48%, transparent 66%); transform: translateX(-120%); pointer-events: none; }
  .start-button:is(:hover, :focus-visible) .start-im::after { animation: im-gleam 480ms steps(6, end) 1; }
  .start-button:is(:hover, :focus-visible, [aria-expanded="true"]) .start-im { box-shadow: 0 1px 6px rgb(156 237 114 / .65); }
  .start-button:active .start-im { transform: translateY(1px); }
  @keyframes im-gleam { to { transform: translateX(120%); } }
  @media (prefers-reduced-motion: reduce) {
    .start-button:is(:hover, :focus-visible) .start-im::after { animation: none; transform: none; opacity: .2; }
    .start-button:active .start-im { transform: none; }
  }
</style>
