---
import Icon from './Icon.astro';
import StartMenu from './StartMenu.astro';
import SocialIcon from './SocialIcon.astro';
import { navigation } from '../../data/navigation';
import { socialLinks } from '../../data/social';
import type { IconName } from '../../data/navigation';
interface Props { path: string; title: string; icon: IconName | 'warning' | 'project' }
const { path, title, icon } = Astro.props;
const pinned = navigation.filter((item) => ['/', '/about', '/portfolio', '/cv', '/blog', '/contact'].includes(item.href));
// Compact screens keep five labeled tabs; everything else lives in Start.
const compactPins = ['/', '/about', '/portfolio', '/cv', '/contact'];
const currentIsPinned = pinned.some((item) => item.href === path);
// A nested route (a project, an article) belongs to its index's section.
const sectionOf = (href: string) => href !== '/' && path.startsWith(`${href}/`);
const inCompactBar = compactPins.some((href) => href === path || sectionOf(href));
---

<StartMenu path={path} />
<footer class="taskbar">
  <button class="start-button" type="button" aria-label="Start" aria-controls="start-menu" aria-expanded="false" data-start-button data-holds-current={inCompactBar ? undefined : ''}>
    <span class="start-im" aria-hidden="true"><img src="/images/im-start-green.svg" width="36" height="36" alt="" /></span><span class="start-label">Start</span>
  </button>
  <span class="taskbar-separator" aria-hidden="true"></span>
  <nav class="taskbar-pins" aria-label="Pinned pages">
    {pinned.map((item) => (
      <a
        class:list={['taskbar-item', {
          'is-open is-active': item.href === path,
          'is-section': sectionOf(item.href),
          'taskbar-item--wide-only': !compactPins.includes(item.href),
        }]}
        href={item.href}
        data-window-link
        data-taskbar-route={item.href}
        aria-label={`Open ${item.label}`}
        aria-current={item.href === path ? 'page' : undefined}
      >
        <Icon name={item.icon} size={22} /><span>{item.label === 'Welcome' ? 'Home' : item.label}</span>
      </a>
    ))}
  </nav>
  <div class="taskbar-running" data-taskbar-running>
    {!currentIsPinned && (
      <a class="taskbar-item is-open is-active" href={path} data-taskbar-route={path} aria-label={`Restore ${title}`}>
        <Icon name={icon} size={22} /><span>{title}</span>
      </a>
    )}
  </div>
  <div class="taskbar-spacer"></div>
  <nav class="taskbar-socials" aria-label="Social profiles">
    {socialLinks.map((link) => (
      <a href={link.href} target="_blank" rel="me noopener" aria-label={link.label} title={link.label}>
        <SocialIcon name={link.label} size={17} />
      </a>
    ))}
  </nav>
  <span class="taskbar-separator" aria-hidden="true"></span>
  <div class="taskbar-clock" aria-label="Current local time"><time data-clock></time><span data-date>Central</span></div>
</footer>

