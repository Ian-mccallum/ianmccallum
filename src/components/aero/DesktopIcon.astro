---
import Icon from './Icon.astro';
import type { IconName } from '../../data/navigation';
interface Props { href: string; label: string; icon: IconName }
const { href, label, icon } = Astro.props;
---

<a class="desktop-icon" href={href} aria-label={`Open ${label}`} data-window-link>
  <span class="desktop-icon__image"><Icon name={icon} size={44} loading="lazy" /></span>
  <span>{label}</span>
</a>
