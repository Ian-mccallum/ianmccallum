---
import BackgroundAtmosphere from './BackgroundAtmosphere.astro';
import DesktopIcon from './DesktopIcon.astro';
import Taskbar from './Taskbar.astro';
import WindowFrame from './WindowFrame.astro';
import { navigation, type IconName } from '../../data/navigation';

interface Props {
  path: string;
  title: string;
  windowTitle: string;
  icon: IconName | 'warning' | 'project';
  reading?: boolean;
  root?: boolean;
}
const { path, title, windowTitle, icon, reading = false, root = false } = Astro.props;
---

<BackgroundAtmosphere />
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="desktop" data-aero-shell>
  <nav class="desktop-icons" aria-label="Desktop shortcuts">
    {navigation.filter((item) => item.href !== '/').map((item) => <DesktopIcon {...item} />)}
  </nav>
  <main id="main-content" class="desktop-workspace" tabindex="-1" data-window-host>
    <WindowFrame title={windowTitle} icon={icon} reading={reading} path={path} restored={root}><slot /></WindowFrame>
    <p class="sr-only" role="status" aria-live="polite" data-window-status></p>
  </main>
  <Taskbar path={path} title={title} icon={icon} />
</div>
{root && (
  <div class="boot-overlay" data-boot-overlay hidden aria-label="Starting Ian McCallum's personal desktop">
    <div class="boot-sky" data-boot-sky aria-hidden="true">
      <div class="boot-sun"></div>
      <div class="boot-aurora boot-aurora--cyan"></div>
      <div class="boot-aurora boot-aurora--violet"></div>
      <div class="boot-horizon"></div>
      <div class="boot-bubbles">
        <span style="--x: 7%; --size: 22px; --delay: .2s"></span>
        <span style="--x: 17%; --size: 13px; --delay: 1.4s"></span>
        <span style="--x: 29%; --size: 30px; --delay: .8s"></span>
        <span style="--x: 43%; --size: 17px; --delay: 2s"></span>
        <span style="--x: 58%; --size: 25px; --delay: .4s"></span>
        <span style="--x: 72%; --size: 14px; --delay: 1.7s"></span>
        <span style="--x: 84%; --size: 33px; --delay: .1s"></span>
        <span style="--x: 94%; --size: 19px; --delay: 1.1s"></span>
      </div>
      <div class="boot-particles" data-boot-particles></div>
    </div>
    <div class="boot-vignette" aria-hidden="true"></div>
    <div class="boot-content">
      <div class="boot-orb" aria-hidden="true">
        <span class="boot-orb__ring"></span>
        <span class="boot-orb__halo"></span>
        <span class="boot-orb__glass">IM</span>
      </div>
      <p class="boot-name">ian mccallum</p>
      <p class="boot-edition">Personal desktop · Aero edition</p>
      <div class="boot-progress" role="progressbar" aria-label="Starting personal desktop" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-boot-progress>
        <div class="boot-progress__header">
          <span>Starting experience</span>
          <output data-boot-percent>0%</output>
        </div>
        <div class="boot-progress__track"><span data-boot-progress-bar></span></div>
        <p class="boot-status" aria-live="polite" data-boot-status>Preparing your atmosphere…</p>
      </div>
      <a class="boot-skip" href="#main-content" data-skip-boot>Skip welcome</a>
    </div>
  </div>
)}

<script src="../../scripts/aero-window.ts"></script>
