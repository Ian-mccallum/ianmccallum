<div class="email-shield" data-email-shield>
  <button class="aero-button aero-button--secondary" type="button" data-email-reveal>Reveal protected email</button>
  <div class="email-challenge" data-email-challenge hidden>
    <label data-email-question for="email-answer">Quick check</label>
    <input id="email-answer" inputmode="numeric" pattern="[0-9]*" enterkeyhint="done" autocomplete="off" aria-describedby="email-error" />
    <button class="aero-button aero-button--secondary" type="button" data-email-verify>Verify</button>
    <span class="email-error" id="email-error" role="alert" data-email-error hidden>That answer didn’t match. Try the new one.</span>
  </div>
  <div class="email-output" data-email-output hidden>
    <a class="email-address" data-email-link href="#">Email Ian</a>
    <button class="aero-button aero-button--secondary" type="button" data-email-copy hidden>Copy address</button>
    <span class="email-copied" role="status" data-email-copied></span>
  </div>
</div>
