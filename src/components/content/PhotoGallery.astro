---
import { Image } from 'astro:assets';
import { photos } from '../../data/photos';
---

<div class="gallery" data-gallery>
  {photos.map((photo, index) => (
    <button type="button" data-gallery-item={index} aria-label={`Open image ${index + 1}: ${photo.alt}`}>
      <Image src={photo.src} alt={photo.alt} widths={[360, 640, 960, 1280, 1600]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" loading={index < 2 ? 'eager' : 'lazy'} />
    </button>
  ))}
</div>
<div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close photo viewer"><span aria-hidden="true"></span></button>
  <figure class="lightbox__stage" data-lightbox-stage>
    <figcaption class="lightbox__caption"><span data-lightbox-caption></span><span class="lightbox__count" data-lightbox-count></span></figcaption>
  </figure>
  <button class="lightbox__step lightbox__step--prev" type="button" data-lightbox-prev aria-label="Previous photo"><span aria-hidden="true"></span></button>
  <button class="lightbox__step lightbox__step--next" type="button" data-lightbox-next aria-label="Next photo"><span aria-hidden="true"></span></button>
</div>
