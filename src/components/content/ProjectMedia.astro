---
interface Props { src: string; poster: string; title: string }
const { src, poster, title } = Astro.props;
---

<figure class="project-media">
  <video controls muted playsinline preload="none" poster={poster} aria-label={`${title} project demonstration`}>
    <source src={src} type="video/mp4" />
    Your browser does not support embedded video. <a href={src}>Open the project video</a>.
  </video>
</figure>
