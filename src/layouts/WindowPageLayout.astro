---
import BaseHead from '../components/seo/BaseHead.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import AeroShell from '../components/aero/AeroShell.astro';
import type { IconName } from '../data/navigation';
import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/aero-materials.css';
import '../styles/components.css';
import '../styles/utilities.css';

interface Props {
  title: string;
  description: string;
  windowTitle: string;
  icon: IconName | 'warning' | 'project';
  path?: string;
  reading?: boolean;
  root?: boolean;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  publishedAt?: Date;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title, description, windowTitle, icon, path = Astro.url.pathname,
  reading = false, root = false, type = 'website', image, publishedAt, schema,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} type={type} image={image} publishedAt={publishedAt} />
    {schema && <StructuredData data={schema} />}
  </head>
  <body>
    <!-- AERO-MIGRATION-CONTRACT
    THESIS: Every canonical URL reconstructs one useful Aero window; the site refuses the hidden-page desktop and the generic portfolio hero.
    OWN-WORLD: 2009 Aero atmosphere, water-blue chrome, warm-white reading beds, tight titlebars, locally controlled period icons, and violet gloss actions.
    STORY: Visitors grasp Ian's breadth, inspect credible engineering and client evidence, then reach the CV, work, writing, or contact path directly.
    FIRST VIEWPORT: A real linked desktop surrounds one maximized active window; mobile becomes a compact Aero document with the same route and content.
    FORM: Established visual world, URL-as-window architecture, code-led from the pinned brief (aero-migration-v1).
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <AeroShell path={path} title={windowTitle} windowTitle={windowTitle} icon={icon} reading={reading} root={root}>
      <slot />
    </AeroShell>
  </body>
</html>
