---
import WindowPageLayout from '../layouts/WindowPageLayout.astro';
---

<WindowPageLayout title="Thank You | Ian McCallum" description="Thank you for contacting Ian McCallum. Your message has been received." windowTitle="Message received" icon="contact">
  <div class="page-sheet page-sheet--narrow">
    <h1>Your message is in.</h1>
    <p class="lede">Thank you for reaching out. I read every message and will reply personally.</p>
    <div class="button-row"><a class="aero-button" href="/">Return to the desktop</a><a class="aero-button aero-button--secondary" href="/portfolio">Browse project work</a></div>
  </div>
</WindowPageLayout>
