---
import WindowPageLayout from '../layouts/WindowPageLayout.astro';
import EmailShield from '../components/content/EmailShield.astro';
import Icon from '../components/aero/Icon.astro';
import { personReference } from '../data/identity';
const schema = { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Ian McCallum', url: 'https://www.ianmccallum.com/contact', mainEntity: personReference };
---

<WindowPageLayout title="Contact Ian McCallum | AI, Web & Collaboration" description="Contact Ian McCallum about practical AI systems, web development, projects, or collaboration." windowTitle="Contact — Get in Touch" icon="contact" schema={schema}>
  <div class="page-sheet page-sheet--narrow contact-reveal-page">
    <h1>Email Ian</h1>
    <p class="page-intro">A quick check keeps the address away from crawlers. Reveal it, then use whichever mail app you prefer.</p>
    <section class="contact-reveal" aria-labelledby="protected-email-heading">
      <Icon name="contact" size={64} />
      <div>
        <h2 id="protected-email-heading">Protected email</h2>
        <p>I read every message and reply personally.</p>
        <EmailShield />
      </div>
    </section>
  </div>
</WindowPageLayout>
