---
import WindowPageLayout from '../layouts/WindowPageLayout.astro';
---

<WindowPageLayout title="Page Not Found | Ian McCallum" description="The requested page could not be found." windowTitle="Page not found" icon="warning" noindex>
  <div class="page-sheet page-sheet--narrow">
    <h1>That window could not be opened.</h1>
    <p class="lede">The address may be old, incomplete, or no longer available. The desktop and its main routes are still here.</p>
    <div class="button-row"><a class="aero-button" href="/">Return home</a><a class="aero-button aero-button--secondary" href="/portfolio">Open Portfolio</a><a class="aero-button aero-button--secondary" href="/blog">Open Blog</a></div>
  </div>
</WindowPageLayout>
